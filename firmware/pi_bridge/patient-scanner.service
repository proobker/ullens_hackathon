[Unit]
Description=Pran Rekha Arduino RFID scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/patient-scanner
EnvironmentFile=%h/patient-scanner/scanner.env
ExecStart=/usr/bin/python3 %h/patient-scanner/scanner.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
